# ====================================================================
# VPS 部署环境变量（复制本文件为 .env.deploy 后填写）
#   cp .env.deploy.example .env.deploy
#
# 注意：
#   - 前端的 VITE_ 变量在「构建期」注入，写死后编进产物
#   - 后端运行时变量由 docker-compose 里的 environment 注入
#   - 修改 VITE_ 变量后必须重新 build：docker compose --env-file .env.deploy up -d --build
# ====================================================================

# ----- 前端构建期变量（Vite，会硬编码进 JS 产物）-----
# Bangumi 个人访问令牌：https://next.bgm.tv/demo/access-token
VITE_BANGUMI_ACCESS_TOKEN=你的access_token

# Bangumi 要求的 User-Agent，建议带项目地址和联系方式
VITE_BANGUMI_USER_AGENT=your-app-name (https://github.com/your-name/galgame-grid)

# VNDB API Key：https://vndb.org/u/tokens （仅 VNDB 游戏搜索用到）
VITE_VNDB_API_KEY=你的vndb_api_key

# 站点标题与描述
VITE_APP_TITLE=年度Galgame大赏
VITE_APP_DESCRIPTION=Galgame年度评选生成器

# ----- 运行期变量 -----
# 对外暴露的端口（nginx 监听），改这里即可换端口
PUBLIC_PORT=8080

# 是否启用保存统计功能（写 SQLite）。不需要统计可设 false，仍能正常生成图片
SAVE_ENABLED=true
